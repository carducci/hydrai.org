@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.

_:finding0 a hc:Finding;
    hc:about <https://mago.co/ns#AccessTokenCollection>;
    hc:findingKind hc:UnprojectableOperation;
    hc:message "POST on <https://mago.co/ns#AccessTokenCollection> expects <https://mago.co/ns#AccessTokenInputShape>, which the vocabulary does not describe as a supported class. The operation is offered without a body schema, so its payload cannot be validated. Declaring that class would fix it.";
    hc:detectedAt "2026-08-02T00:21:46.352Z"^^xsd:dateTime.
